Q.1) Write a program to implement Fractional Knapsack problems using Greedy Method
#include <stdio.h>
#include <stdlib.h>

typedef struct
{
    int weight;
    int profit;
    float ratio;
} Item;

int compare(const void *a, const void *b)
{
    Item *i1 = (Item *)a;
    Item *i2 = (Item *)b;

    if (i2->ratio > i1->ratio)
        return 1;
    else if (i2->ratio < i1->ratio)
        return -1;

    return 0;
}

int main()
{
    int n, capacity;

    printf("Enter number of items: ");
    scanf("%d", &n);

    Item items[n];

    printf("Enter weight and profit of each item:\n");

    for (int i = 0; i < n; i++)
    {
        scanf("%d %d", &items[i].weight, &items[i].profit);

        items[i].ratio = (float)items[i].profit / items[i].weight;
    }

    printf("Enter capacity of knapsack: ");
    scanf("%d", &capacity);

    qsort(items, n, sizeof(Item), compare);

    float totalProfit = 0.0;

    for (int i = 0; i < n; i++)
    {
        if (capacity >= items[i].weight)
        {
            capacity -= items[i].weight;
            totalProfit += items[i].profit;
        }
        else
        {
            totalProfit += items[i].profit *
                           ((float)capacity / items[i].weight);

            break;
        }
    }

    printf("Maximum Profit = %.2f\n", totalProfit);

    return 0;
}
Q.2) Write Program to implement Traveling Salesman Problem using nearest neighbor 
algorithm

#include <stdio.h>

#define MAX 20
#define INF 99999

int main()
{
    int n;
    int cost[MAX][MAX];
    int visited[MAX] = {0};

    int i, j;

    printf("Enter number of cities: ");
    scanf("%d", &n);

    printf("Enter cost matrix:\n");

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
        {
            scanf("%d", &cost[i][j]);
        }
    }

    int current = 0;
    visited[current] = 1;

    int count = 1;
    int totalCost = 0;

    printf("Path: %d ", current + 1);

    while (count < n)
    {
        int nearest = -1;
        int minCost = INF;

        for (i = 0; i < n; i++)
        {
            if (!visited[i] &&
                cost[current][i] < minCost &&
                cost[current][i] != 0)
            {
                minCost = cost[current][i];
                nearest = i;
            }
        }

        if (nearest != -1)
        {
            visited[nearest] = 1;

            printf("-> %d ", nearest + 1);

            totalCost += minCost;

            current = nearest;

            count++;
        }
    }

    totalCost += cost[current][0];

    printf("-> 1");

    printf("\nMinimum Cost = %d\n", totalCost);

    return 0;
}





