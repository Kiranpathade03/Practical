Q.1) Write a program to implement for finding Topological sorting and determine the time complexity for the same

#include <stdio.h>

#define MAX 100

int graph[MAX][MAX];
int visited[MAX];
int stack[MAX];
int top = -1;
int n;

void topologicalSort(int vertex)
{
    visited[vertex] = 1;

    for (int i = 0; i < n; i++)
    {
        if (graph[vertex][i] == 1 && !visited[i])
        {
            topologicalSort(i);
        }
    }

    stack[++top] = vertex;
}

int main()
{
    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            scanf("%d", &graph[i][j]);
        }
    }

    for (int i = 0; i < n; i++)
    {
        visited[i] = 0;
    }

    for (int i = 0; i < n; i++)
    {
        if (!visited[i])
        {
            topologicalSort(i);
        }
    }

    printf("Topological Order:\n");

    while (top != -1)
    {
        printf("%d ", stack[top--]);
    }

    return 0;
}
Q.2) Write a program to solve N Queens Problem using Backtracking.

#include <stdio.h>

#define MAX 20

int board[MAX];
int n;

int isSafe(int row, int col)
{
    for (int i = 0; i < row; i++)
    {
        if (board[i] == col ||
            abs(board[i] - col) == abs(i - row))
        {
            return 0;
        }
    }

    return 1;
}

void printSolution()
{
    printf("\nSolution:\n\n");

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            if (board[i] == j)
                printf("Q ");
            else
                printf(". ");
        }

        printf("\n");
    }
}

int solveNQueen(int row)
{
    if (row == n)
    {
        printSolution();
        return 1;
    }

    for (int col = 0; col < n; col++)
    {
        if (isSafe(row, col))
        {
            board[row] = col;

            if (solveNQueen(row + 1))
                return 1;
        }
    }

    return 0;
}

int main()
{
    printf("Enter value of N: ");
    scanf("%d", &n);

    if (!solveNQueen(0))
    {
        printf("No solution exists.");
    }

    return 0;
}